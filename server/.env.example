PORT=4000
# Leave empty to use an in-memory MongoDB (zero setup, resets on restart)
MONGO_URI=
JWT_SECRET=change-me
CLIENT_ORIGIN=*
# gemini (default) | ollama | mock
GEMMA_PROVIDER=gemini
# Set in your shell or a local .env (never commit it)
GEMINI_API_KEY=
GEMMA_VISION_MODEL=gemma-4-26b-a4b-it
GEMMA_FALLBACK_VISION_MODEL=gemma-4-31b-it
GEMMA_TEXT_MODEL=gemma-4-26b-a4b-it
GEMMA_LIVE_THINKING=minimal
GEMMA_LIVE_MAX_TOKENS=320
GEMMA_TIMEOUT_MS=45000
GEMMA_RETRIES=1
# Scripted ~1.5 s responses, clearly labelled "Demo mode" in the UI (also a per-device toggle in Settings)
DEMO_MODE=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4
# Optional Africa's Talking SMS (disabled by default)
AT_SMS_ENABLED=false
AT_USERNAME=sandbox
AT_API_KEY=
AT_SUPERVISOR_PHONE=
AT_RISK_THRESHOLD=70
